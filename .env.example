# ApplyXAI SaaS backend configuration.
# Copy to .env (never commit .env) and fill in. Every value can also be set as a real
# environment variable, which takes precedence over this file.
# The classic control panel (python app.py) does not read this file.

# development | test | production
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ chars) when APP_ENV=production.
SECRET_KEY=
JWT_SECRET=

# Empty = local SQLite at storage/applyxai.db. Production requires PostgreSQL, e.g.
# postgresql+psycopg://applyxai:CHANGE_ME@127.0.0.1:5432/applyxai
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base URL of the web app, used for links in verification and password-reset emails.
FRONTEND_URL=http://localhost:5173
# Desktop agent download (API prefers Setup.exe, then GUI.exe): dist/ApplyXAI-Agent-Setup.exe
# DESKTOP_AGENT_SETUP_PATH=
# DESKTOP_AGENT_GUI_PATH=

# Sessions
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=true
# Empty = Secure cookies only when APP_ENV=production (forced on there).
COOKIE_SECURE=

# memory:// for a single dev server; production requires Redis, e.g. redis://localhost:6379/1
RATE_LIMIT_STORAGE_URL=memory://

# Empty SMTP_HOST = emails are printed to the API console. Required in production.
# Port 587 = STARTTLS, 465 = implicit SSL.
# Amazon SES (production EC2 region ap-southeast-2): see docs/SES.md and scripts/setup_ses.ps1
#   SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
#   SMTP_USERNAME / SMTP_PASSWORD = SES SMTP credentials (password derived via scripts/ses_smtp_password.py)
# Gmail: smtp.gmail.com + App Password. Test from Admin → Settings → Email & SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ApplyXAI <no-reply@applyxai.com>

# null (development only: grants plans without payment) | razorpay
# For Razorpay: Key ID and Key Secret from Dashboard > Account & Settings > API Keys (use test
# keys rzp_test_... until launch), and the secret you set on the webhook pointing at
# https://<your-domain>/api/billing/webhook/razorpay. Then run:
#   venv\Scripts\python -m backend.app.cli sync-plans
PAYMENT_PROVIDER=null
PAYMENT_KEY_ID=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Optional: allow /billing/checkout to grant paid plans without Razorpay when PAYMENT_PROVIDER=null (local dev only).
PAYMENT_DEV_INSTANT_CHECKOUT=false
