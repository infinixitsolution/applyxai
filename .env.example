# ApplyXAI SaaS backend configuration.
# Copy to .env (never commit .env) and fill in. Every value can also be set as a real
# environment variable, which takes precedence over this file.
# The classic control panel (python app.py) does not read this file.

# development | test | production
APP_ENV=development

# Staging: treat Naukri as enabled in job_sources even if admin left it off (production: use admin toggle).
# ENABLE_NAUKRI=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ chars) when APP_ENV=production.
SECRET_KEY=
JWT_SECRET=

# Empty = local SQLite at storage/applyxai.db. Production requires PostgreSQL, e.g.
# postgresql+psycopg://applyxai:CHANGE_ME@127.0.0.1:5432/applyxai
DATABASE_URL=
# After pulling new code, upgrade schema: alembic -c backend/alembic.ini upgrade head
# (scripts/dev_api.ps1 runs this automatically before uvicorn)
REDIS_URL=redis://localhost:6379/0

# Local dev API URL (Vite + desktop proxy). Default 8010 avoids port 8000 conflicts.
# APPLYXAI_API_URL=http://127.0.0.1:8010

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base URL of the web app, used for links in verification and password-reset emails.
FRONTEND_URL=http://localhost:5173
# ApplyXAI Desktop download (single installer): dist/ApplyXAI-Desktop-Setup.exe
# DESKTOP_APP_SETUP_PATH=
# DESKTOP_APP_ZIP_PATH=

# Sessions
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=true
# Empty = Secure cookies only when APP_ENV=production (forced on there).
COOKIE_SECURE=

# memory:// for a single dev server; production requires Redis, e.g. redis://localhost:6379/1
RATE_LIMIT_STORAGE_URL=memory://

# Empty SMTP_HOST = emails are printed to the API console. Required in production.
# Port 587 = STARTTLS, 465 = implicit SSL.
# Production uses Hostinger: smtp.hostinger.com, port 465, the noreply@applyxai.com mailbox. See docs/EMAIL.md.
# SMTP_FROM must be the same mailbox as SMTP_USERNAME; Hostinger refuses any other sender.
# Admin → Settings → Email & SMTP overrides these values. Test from there.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ApplyXAI <noreply@applyxai.com>"

# null (development only: grants plans without payment) | razorpay
# For Razorpay: Key ID and Key Secret from Dashboard > Account & Settings > API Keys (use test
# keys rzp_test_... until launch), and the secret you set on the webhook pointing at
# https://<your-domain>/api/billing/webhook/razorpay. Then run:
#   venv\Scripts\python -m backend.app.cli sync-plans
PAYMENT_PROVIDER=null
PAYMENT_KEY_ID=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Optional: allow /billing/checkout to grant paid plans without Razorpay when PAYMENT_PROVIDER=null (local dev only).
PAYMENT_DEV_INSTANT_CHECKOUT=false

# Optional ClamAV (clamd) resume scanning. Leave CLAMAV_HOST empty to disable.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SCAN_TIMEOUT_SEC=30

# Desktop agent release advertised to clients (/api/site/agent-release).
# Defaults to the repo VERSION file when unset.
# AGENT_LATEST_VERSION=1.2.21
# AGENT_DOWNLOAD_URL=

# Comma-separated emails with unlimited mock interviews (other plan limits unchanged).
# Prefer DB allowlist (survives deploy; required for packaged Desktop → production API):
#   python -m backend.app.cli mock-unlimited --add --email you@example.com
# MOCK_INTERVIEWS_UNLIMITED_EMAILS=you@example.com

# Mock interview interviewer voice — prefer Admin → Settings → AI → Mock interview voice (ElevenLabs)
# ELEVENLABS_API_KEY=

# Institute outreach (admin scraping + marketing)
# FIRECRAWL_API_KEY=
# WHATSAPP_BRIDGE_URL=http://127.0.0.1:39219
# Shared secret: API WHATSAPP_BRIDGE_SECRET + bridge WHATSAPP_BRIDGE_SECRET (inbound chat from institutes)
# Required for live inbound chat (bridge forwards replies to the API). Use the same value on bridge + API.
# WHATSAPP_BRIDGE_SECRET=dev-whatsapp-bridge-local
# Bridge forwards replies to API (same machine as API in dev):
# APPLYXAI_API_URL=http://127.0.0.1:8010
# OUTREACH_MAX_LEADS_PER_JOB=50
# OUTREACH_AUTOMATION_ENABLED=true
